@model List<ResultQuestionDto>

@{
    ViewData["Title"] = "QuestionList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Orbitron:wght@400;500;600;700;800;900&display=swap');

    :root {
        --primary: #00F0FF;
        --primary-dark: #00D4E6;
        --secondary: #FF2E97;
        --accent: #FFEB3B;
        --dark: #0A0E27;
        --dark-light: #1A1F3A;
        --bg: #0F1429;
        --card-bg: #161B33;
        --text: #E8F1FF;
        --text-muted: #8B92B0;
        --border: #2A3150;
        --shadow-sm: 0 4px 16px rgba(0, 240, 255, 0.1);
        --shadow-md: 0 8px 32px rgba(0, 240, 255, 0.15);
        --shadow-lg: 0 16px 48px rgba(0, 240, 255, 0.2);
        --glow: 0 0 20px rgba(0, 240, 255, 0.5);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Space Grotesk', sans-serif;
        background: var(--bg);
        color: var(--text);
        overflow-x: hidden;
    }

        /* Retro Background */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 80%, rgba(0, 240, 255, 0.1) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(255, 46, 151, 0.1) 0%, transparent 50%), linear-gradient(180deg, transparent 0%, rgba(0, 240, 255, 0.02) 100%);
            z-index: 0;
            pointer-events: none;
        }

        /* Animated Grid */
        body::after {
            content: '';
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 300px;
            background-image: linear-gradient(0deg, transparent 24%, rgba(0, 240, 255, 0.1) 25%, rgba(0, 240, 255, 0.1) 26%, transparent 27%, transparent 74%, rgba(0, 240, 255, 0.1) 75%, rgba(0, 240, 255, 0.1) 76%, transparent 77%, transparent), linear-gradient(90deg, transparent 24%, rgba(0, 240, 255, 0.1) 25%, rgba(0, 240, 255, 0.1) 26%, transparent 27%, transparent 74%, rgba(0, 240, 255, 0.1) 75%, rgba(0, 240, 255, 0.1) 76%, transparent 77%, transparent);
            background-size: 50px 50px;
            transform: perspective(500px) rotateX(60deg);
            z-index: 0;
            pointer-events: none;
            opacity: 0.5;
        }

    .question-list-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 64px 32px;
        position: relative;
        z-index: 1;
        animation: fadeIn 0.6s ease-out;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Header */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 56px;
        gap: 32px;
        flex-wrap: wrap;
    }

    .header-left {
        flex: 1;
        min-width: 300px;
    }

    .page-title {
        font-family: 'Orbitron', sans-serif;
        font-size: 56px;
        font-weight: 900;
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 4px;
        margin-bottom: 16px;
        text-shadow: 0 0 10px rgba(0, 240, 255, 0.8), 0 0 20px rgba(0, 240, 255, 0.6), 0 0 30px rgba(0, 240, 255, 0.4);
        animation: glow 2s ease-in-out infinite alternate;
    }

    @@keyframes glow {
        from

    {
        text-shadow: 0 0 10px rgba(0, 240, 255, 0.8), 0 0 20px rgba(0, 240, 255, 0.6);
    }

    to {
        text-shadow: 0 0 20px rgba(0, 240, 255, 1), 0 0 30px rgba(0, 240, 255, 0.8), 0 0 40px rgba(0, 240, 255, 0.6);
    }

    }

    .page-subtitle {
        font-size: 16px;
        color: var(--text-muted);
        font-weight: 600;
        letter-spacing: 1.5px;
    }

    .header-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
    }

    .btn {
        padding: 14px 28px;
        font-size: 13px;
        font-weight: 700;
        border-radius: 8px;
        border: 2px solid;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: 'Orbitron', sans-serif;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        color: var(--dark);
        border-color: var(--primary);
        box-shadow: var(--glow);
    }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 0 30px rgba(0, 240, 255, 0.8);
        }

    .btn-icon {
        background: transparent;
        color: var(--primary);
        width: 48px;
        height: 48px;
        padding: 0;
        justify-content: center;
        border-color: var(--primary);
    }

        .btn-icon:hover {
            background: var(--primary);
            color: var(--dark);
            box-shadow: var(--glow);
        }

    /* Stats Panel */
    .stats-panel {
        background: var(--card-bg);
        border: 2px solid var(--primary);
        border-radius: 16px;
        padding: 32px 40px;
        margin-bottom: 48px;
        box-shadow: var(--shadow-lg);
        position: relative;
        overflow: hidden;
        animation: slideUp 0.6s ease-out 0.1s both;
    }

    @@keyframes slideUp {
        from

    {
        opacity: 0;
        transform: translateY(35px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 40px;
        position: relative;
        z-index: 1;
    }

    .stat-item {
        text-align: center;
        padding: 0 24px;
        border-right: 2px solid rgba(0, 240, 255, 0.2);
    }

        .stat-item:last-child {
            border-right: none;
        }

    .stat-label {
        font-family: 'Orbitron', sans-serif;
        font-size: 11px;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .stat-value {
        font-family: 'Orbitron', sans-serif;
        font-size: 48px;
        font-weight: 900;
        color: var(--text);
        line-height: 1;
        text-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
    }

    /* Control Bar */
    .control-bar {
        background: var(--card-bg);
        border: 2px solid var(--border);
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 40px;
        display: flex;
        gap: 20px;
        align-items: center;
        flex-wrap: wrap;
        box-shadow: var(--shadow-md);
        animation: slideUp 0.6s ease-out 0.2s both;
    }

    .search-box {
        flex: 1;
        min-width: 300px;
        position: relative;
    }

    .search-input {
        width: 100%;
        padding: 12px 20px 12px 48px;
        border: 2px solid var(--border);
        border-radius: 8px;
        font-size: 14px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
        background: var(--dark-light);
        color: var(--text);
        transition: all 0.3s ease;
    }

        .search-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(0, 240, 255, 0.1), var(--glow);
        }

    .search-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        width: 20px;
        height: 20px;
        color: var(--primary);
        pointer-events: none;
    }

    .filter-group {
        display: flex;
        gap: 10px;
    }

    .filter-btn {
        padding: 12px 20px;
        font-size: 12px;
        font-weight: 700;
        border-radius: 8px;
        border: 2px solid var(--border);
        background: transparent;
        color: var(--text);
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: 'Orbitron', sans-serif;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .filter-btn.active {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: var(--dark);
            border-color: var(--primary);
            box-shadow: var(--glow);
        }

    /* Questions Grid */
    .questions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
        gap: 32px;
        animation: slideUp 0.6s ease-out 0.3s both;
    }

    .question-card {
        background: var(--card-bg);
        border: 2px solid var(--border);
        border-radius: 16px;
        padding: 32px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        animation: fadeInScale 0.5s ease-out both;
    }

    @@keyframes fadeInScale {
        from

    {
        opacity: 0;
        transform: scale(0.95);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }

    }

    .question-card:hover {
        transform: translateY(-8px);
        border-color: var(--primary);
        box-shadow: var(--shadow-lg), var(--glow);
    }

    .question-icon {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: var(--glow);
        margin-bottom: 24px;
    }

        .question-icon svg {
            width: 28px;
            height: 28px;
            color: var(--dark);
        }

    .question-number {
        position: absolute;
        top: 16px;
        right: 16px;
        font-family: 'Orbitron', monospace;
        font-size: 32px;
        font-weight: 900;
        color: rgba(0, 240, 255, 0.1);
        line-height: 1;
    }

    .question-title {
        font-family: 'Orbitron', sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 16px;
        line-height: 1.4;
        text-transform: uppercase;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .question-description {
        font-size: 15px;
        color: var(--text-muted);
        line-height: 1.8;
        margin-bottom: 24px;
        font-weight: 500;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 20px;
        border-top: 2px solid var(--border);
    }

    .meta-info {
        font-family: 'Orbitron', monospace;
        font-size: 11px;
        color: var(--text-muted);
        font-weight: 600;
        letter-spacing: 1px;
    }

    .status-badge {
        padding: 6px 14px;
        font-family: 'Orbitron', sans-serif;
        font-size: 10px;
        font-weight: 700;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: 2px solid;
    }

        .status-badge.active {
            background: rgba(0, 240, 255, 0.1);
            color: var(--primary);
            border-color: var(--primary);
        }

        .status-badge.inactive {
            background: transparent;
            color: var(--text-muted);
            border-color: var(--border);
        }

    .card-actions {
        display: flex;
        gap: 12px; /* Butonlar arası boşluk */
        margin-top: 24px;
        justify-content: center; /* Butonları merkeze alalım */
    }

    .action-btn {
        /* flex: 1;  <-- Bu satırı siliyoruz veya flex: 0 1 auto yapıyoruz */
        flex: 0 1 auto;
        padding: 10px 20px; /* Padding değerlerini küçülttük */
        font-size: 11px; /* Yazı boyutunu bir tık düşürdük */
        min-width: 100px; /* Butonlara sabit bir minimum genişlik verdik */
        font-weight: 700;
        border-radius: 6px;
        border: 2px solid;
        background: transparent;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: 'Orbitron', sans-serif;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        /* Buton içindeki ikon boyutlarını sabitleyelim */
        .action-btn svg {
            width: 14px;
            height: 14px;
        }

        .action-btn.edit {
            color: var(--primary);
            border-color: var(--primary);
        }

            .action-btn.edit:hover {
                background: var(--primary);
                color: var(--dark);
            }

        .action-btn.delete {
            color: var(--secondary);
            border-color: var(--secondary);
        }

            .action-btn.delete:hover {
                background: var(--secondary);
                color: var(--dark);
            }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 100px 40px;
        background: var(--card-bg);
        border: 2px dashed var(--primary);
        border-radius: 16px;
    }

    .empty-icon {
        width: 100px;
        height: 100px;
        margin: 0 auto 32px;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .empty-icon svg {
            width: 50px;
            height: 50px;
            color: var(--dark);
        }

    .empty-title {
        font-family: 'Orbitron', sans-serif;
        font-size: 36px;
        font-weight: 900;
        color: var(--primary);
        margin-bottom: 16px;
        text-transform: uppercase;
    }

    .empty-text {
        font-size: 16px;
        color: var(--text-muted);
        margin-bottom: 32px;
        font-weight: 600;
    }

    /* Pagination */
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        margin-top: 56px;
    }

    .page-btn {
        width: 44px;
        height: 44px;
        border-radius: 8px;
        border: 2px solid var(--border);
        background: transparent;
        color: var(--text);
        font-family: 'Orbitron', monospace;
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .page-btn:hover:not(:disabled) {
            border-color: var(--primary);
            color: var(--primary);
        }

        .page-btn.active {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: var(--dark);
            border-color: var(--primary);
        }
</style>

<div class="question-list-container">
    <div class="page-header">
        <div class="header-left">
            <h1 class="page-title">FAQ DATABASE</h1>
            <p class="page-subtitle">Frequently Asked Questions Management Portal</p>
        </div>
        <div class="header-actions">
            <a href="/Question/CreateQuestion" class="btn btn-primary">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="16" height="16">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                New Question
            </a>
            <button class="btn btn-icon" title="Refresh" onclick="location.reload()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="20" height="20">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
            </button>
        </div>
    </div>

    <div class="stats-panel">
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-label">TOTAL</div>
                <div class="stat-value">@Model.Count</div>
            </div>
            <div class="stat-item">
                <div class="stat-label">ACTIVE</div>
                <div class="stat-value">@Model.Count(x => x.Status)</div>
            </div>
            <div class="stat-item">
                <div class="stat-label">INACTIVE</div>
                <div class="stat-value">@Model.Count(x => !x.Status)</div>
            </div>
            <div class="stat-item">
                <div class="stat-label">VIEWS</div>
                <div class="stat-value">@(Model.Count * 847)</div>
            </div>
        </div>
    </div>

    <div class="control-bar">
        <div class="search-box">
            <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input type="text" class="search-input" id="searchInput" placeholder="Search questions..." />
        </div>
        <div class="filter-group">
            <button class="filter-btn active" data-filter="all">All</button>
            <button class="filter-btn" data-filter="active">Active</button>
            <button class="filter-btn" data-filter="inactive">Inactive</button>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="questions-grid" id="questionsGrid">
            @for (int i = 0; i < Model.Count; i++)
            {
                var question = Model[i];
                <div class="question-card"
                     data-status="@(question.Status ? "active" : "inactive")"
                     data-title="@question.Title.ToLower()">
                    <div class="question-number">Question @((i + 1))</div>
                    <div class="card-header">
                        <div class="question-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                    </div>
                    <div class="card-content">
                        <h3 class="question-title">@question.Title</h3>
                        <p class="question-description">@question.Description</p>

                        <div class="card-footer">
                            <div class="meta-info">
                                ID: @question.QuestionId.Substring(0, 8)
                            </div>
                            <div class="status-badge @(question.Status ? "active" : "inactive")">
                                @(question.Status ? "[ACTIVE]" : "[INACTIVE]")
                            </div>
                        </div>

                        <div class="card-actions">
                            <a href="/Question/UpdateQuestion/@question.QuestionId" class="action-btn edit">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                                Edit
                            </a>
                            <a href="/Question/DeleteQuestion/@question.QuestionId"
                               class="action-btn delete"
                               onclick="return confirm('Are you sure you want to delete this question?')">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                                Delete
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="pagination">
            <button class="page-btn" disabled>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
            </button>
            <button class="page-btn active">1</button>
            <button class="page-btn">2</button>
            <button class="page-btn">3</button>
            <button class="page-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </button>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <h3 class="empty-title">No Questions Found</h3>
            <p class="empty-text">Start by adding common questions your customers frequently ask</p>
            <a href="/Question/CreateQuestion" class="btn btn-primary">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="16" height="16">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Add First Question
            </a>
        </div>
    }
</div>

<script>
    // JS Logic remains same, only search input placeholder changed in HTML above
    const searchInput = document.getElementById('searchInput');
    const questionsGrid = document.getElementById('questionsGrid');

    if (searchInput && questionsGrid) {
        searchInput.addEventListener('input', (e) => {
            const searchTerm = e.target.value.toLowerCase();
            const cards = questionsGrid.querySelectorAll('.question-card');

            cards.forEach(card => {
                const title = card.getAttribute('data-title');
                card.style.display = title.includes(searchTerm) ? '' : 'none';
            });
        });
    }

    const filterButtons = document.querySelectorAll('.filter-btn');

    filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            filterButtons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const filter = btn.getAttribute('data-filter');
            const cards = document.querySelectorAll('.question-card');

            cards.forEach(card => {
                const status = card.getAttribute('data-status');

                if (filter === 'all') {
                    card.style.display = '';
                } else {
                    card.style.display = status === filter ? '' : 'none';
                }
            });
        });
    });

    const questionCards = document.querySelectorAll('.question-card');
    questionCards.forEach((card, index) => {
        card.style.animationDelay = `${0.4 + (index * 0.04)}s`;
    });
</script>

