@model GetTestimonialByIdDto

@{
    ViewData["Title"] = "UpdateTestimonial";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}




<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800;900&family=Raleway:wght@300;400;500;600;700;800&display=swap');

    :root {
        --gold: #D4AF37;
        --gold-dark: #B8941F;
        --gold-light: #F4D03F;
        --navy: #1A1F2E;
        --navy-light: #2D3748;
        --cream: #F9F7F4;
        --white: #FFFFFF;
        --text: #1A1F2E;
        --text-muted: #6B7280;
        --border: #E5E7EB;
        --shadow-sm: 0 2px 12px rgba(212, 175, 55, 0.08);
        --shadow-md: 0 8px 24px rgba(212, 175, 55, 0.12);
        --shadow-lg: 0 16px 48px rgba(212, 175, 55, 0.18);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Raleway', sans-serif;
        background: var(--cream);
        color: var(--text);
        position: relative;
    }

        /* Art Deco Background Pattern */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: repeating-linear-gradient(45deg, transparent, transparent 20px, rgba(212, 175, 55, 0.02) 20px, rgba(212, 175, 55, 0.02) 40px), repeating-linear-gradient(-45deg, transparent, transparent 20px, rgba(212, 175, 55, 0.02) 20px, rgba(212, 175, 55, 0.02) 40px);
            z-index: 0;
            pointer-events: none;
        }

    .testimonial-create-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 60px 40px;
        position: relative;
        z-index: 1;
        animation: fadeIn 0.9s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Luxury Header */
    .page-header {
        text-align: center;
        margin-bottom: 64px;
        position: relative;
    }

    .header-ornament {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
    }

    .ornament-line {
        width: 80px;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--gold), transparent);
    }

    .ornament-diamond {
        width: 12px;
        height: 12px;
        background: var(--gold);
        transform: rotate(45deg);
        animation: sparkle 3s ease-in-out infinite;
    }

    @@keyframes sparkle {
        0%, 100% {
            opacity: 1;
            transform: rotate(45deg) scale(1);
        }

        50% {
            opacity: 0.7;
            transform: rotate(45deg) scale(1.2);
        }
    }

    .page-title {
        font-family: 'Playfair Display', serif;
        font-size: 56px;
        font-weight: 800;
        color: var(--navy);
        margin-bottom: 16px;
        letter-spacing: -1px;
        line-height: 1.1;
    }

    .title-accent {
        color: var(--gold);
        font-style: italic;
    }

    .page-subtitle {
        font-size: 17px;
        color: var(--text-muted);
        font-weight: 500;
        max-width: 600px;
        margin: 0 auto;
        letter-spacing: 0.5px;
    }

    /* Split Layout */
    .split-layout {
        display: grid;
        grid-template-columns: 1fr 480px;
        gap: 56px;
        animation: slideUp 0.9s ease-out 0.2s both;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Form Column */
    .form-column {
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    .form-section {
        background: var(--white);
        border: 2px solid var(--border);
        padding: 48px;
        position: relative;
    }

        .form-section::before,
        .form-section::after {
            content: '';
            position: absolute;
            width: 20px;
            height: 20px;
            border: 2px solid var(--gold);
        }

        .form-section::before {
            top: -2px;
            left: -2px;
            border-right: none;
            border-bottom: none;
        }

        .form-section::after {
            bottom: -2px;
            right: -2px;
            border-left: none;
            border-top: none;
        }

    .section-title {
        font-family: 'Playfair Display', serif;
        font-size: 26px;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 32px;
        text-align: center;
        position: relative;
        padding-bottom: 20px;
    }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 2px;
            background: var(--gold);
        }

    /* Form Groups */
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .form-group {
        margin-bottom: 28px;
        animation: fadeInUp 0.8s ease-out both;
    }

        .form-group:nth-child(1) {
            animation-delay: 0.1s;
        }

        .form-group:nth-child(2) {
            animation-delay: 0.15s;
        }

        .form-group:nth-child(3) {
            animation-delay: 0.2s;
        }

        .form-group:nth-child(4) {
            animation-delay: 0.25s;
        }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .label-required {
        color: var(--gold);
        margin-left: 4px;
    }

    .form-input,
    .form-textarea {
        width: 100%;
        padding: 16px 20px;
        font-size: 15px;
        font-family: 'Raleway', sans-serif;
        font-weight: 500;
        border: 2px solid var(--border);
        background: var(--cream);
        color: var(--text);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        outline: none;
    }

        .form-input:focus,
        .form-textarea:focus {
            border-color: var(--gold);
            background: var(--white);
            box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.1);
        }

    .form-textarea {
        resize: vertical;
        min-height: 160px;
        line-height: 1.8;
    }

    .input-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 8px;
    }

    .char-counter {
        font-size: 11px;
        color: var(--text-muted);
        font-weight: 600;
    }

    .input-hint {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: var(--text-muted);
        font-weight: 500;
    }

        .input-hint svg {
            width: 14px;
            height: 14px;
            color: var(--gold);
        }

    /* Star Rating */
    .rating-wrapper {
        background: linear-gradient(135deg, rgba(212, 175, 55, 0.08), rgba(212, 175, 55, 0.04));
        border: 2px solid rgba(212, 175, 55, 0.2);
        padding: 28px;
        text-align: center;
    }

    .rating-label {
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 20px;
    }

    .stars-container {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 16px;
    }

    .star {
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .star svg {
            width: 36px;
            height: 36px;
            fill: var(--border);
            stroke: var(--gold);
            stroke-width: 1.5px;
        }

        .star:hover svg, .star.active svg {
            fill: var(--gold);
            transform: scale(1.15);
        }

    .rating-value {
        font-size: 14px;
        color: var(--text-muted);
        font-weight: 600;
    }

    /* Status Toggle */
    .status-wrapper {
        background: var(--navy);
        padding: 28px 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
    }

        .status-wrapper::before, .status-wrapper::after {
            content: '';
            position: absolute;
            width: 16px;
            height: 16px;
            border: 2px solid var(--gold);
        }

        .status-wrapper::before {
            top: -2px;
            left: -2px;
            border-right: none;
            border-bottom: none;
        }

        .status-wrapper::after {
            bottom: -2px;
            right: -2px;
            border-left: none;
            border-top: none;
        }

    .status-label h4 {
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        font-weight: 700;
        color: var(--gold);
        margin-bottom: 6px;
    }

    .status-label p {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.7);
        font-weight: 500;
    }

    .toggle-switch {
        position: relative;
        width: 68px;
        height: 38px;
    }

        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--border);
        transition: 0.4s;
    }

        .toggle-slider:before {
            position: absolute;
            content: "";
            height: 30px;
            width: 30px;
            left: 4px;
            bottom: 4px;
            background: var(--navy);
            transition: 0.4s;
        }

    .toggle-switch input:checked + .toggle-slider {
        background: var(--gold);
    }

        .toggle-switch input:checked + .toggle-slider:before {
            transform: translateX(30px);
            background: var(--white);
        }

    /* Preview Column */
    .preview-column {
        position: sticky;
        top: 40px;
        height: fit-content;
    }

    .preview-wrapper {
        background: var(--navy);
        border: 2px solid var(--gold);
        padding: 56px;
        position: relative;
        animation: slideUp 0.9s ease-out 0.3s both;
    }

    .preview-label {
        text-align: center;
        font-size: 11px;
        font-weight: 700;
        color: var(--gold);
        margin-bottom: 32px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .testimonial-card {
        background: var(--white);
        padding: 40px;
        text-align: center;
        position: relative;
    }

        .testimonial-card::before, .testimonial-card::after {
            content: '';
            position: absolute;
            width: 16px;
            height: 16px;
            border: 2px solid var(--gold);
        }

        .testimonial-card::before {
            top: -2px;
            left: -2px;
            border-right: none;
            border-bottom: none;
        }

        .testimonial-card::after {
            bottom: -2px;
            right: -2px;
            border-left: none;
            border-top: none;
        }

    .quote-icon {
        width: 48px;
        height: 48px;
        margin: 0 auto 24px;
        background: var(--gold);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .quote-icon svg {
            width: 24px;
            height: 24px;
            color: var(--white);
        }

    .avatar-preview {
        width: 120px;
        height: 120px;
        margin: 0 auto 24px;
        border-radius: 50%;
        border: 4px solid var(--gold);
        overflow: hidden;
        background: var(--cream);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    #previewAvatar {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
    }

        #previewAvatar.show {
            display: block;
        }

    .avatar-placeholder svg {
        width: 60px;
        height: 60px;
        color: var(--text-muted);
    }

    .preview-name {
        font-family: 'Playfair Display', serif;
        font-size: 24px;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 8px;
    }

    .preview-title {
        font-size: 14px;
        color: var(--text-muted);
        margin-bottom: 24px;
        font-weight: 600;
    }

    .preview-stars {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin-bottom: 24px;
    }

        .preview-stars svg {
            width: 20px;
            height: 20px;
            fill: var(--gold);
        }

    .preview-review {
        font-size: 15px;
        color: var(--text);
        line-height: 1.8;
        font-style: italic;
        font-weight: 500;
    }

    /* Action Buttons */
    .form-actions {
        display: flex;
        gap: 20px;
        margin-top: 40px;
    }

    .btn {
        flex: 1;
        padding: 20px 36px;
        font-size: 13px;
        font-weight: 700;
        border: 2px solid;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        position: relative;
    }

    .btn-primary {
        background: var(--gold);
        color: var(--navy);
        border-color: var(--gold);
    }

    .btn-secondary {
        background: transparent;
        color: var(--navy);
        border-color: var(--navy);
    }

    .luxury-info {
        background: linear-gradient(135deg, var(--navy), var(--navy-light));
        border: 2px solid var(--gold);
        padding: 32px;
        margin-top: 32px;
        color: white;
    }

    .info-title {
        font-family: 'Playfair Display', serif;
        font-size: 20px;
        font-weight: 700;
        color: var(--gold);
        margin-bottom: 20px;
        text-align: center;
    }

    .info-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

        .info-list li {
            display: flex;
            align-items: start;
            gap: 12px;
            font-size: 14px;
            color: rgba(255, 255, 255, 0.9);
        }

            .info-list li::before {
                content: '◆';
                color: var(--gold);
                font-size: 12px;
                flex-shrink: 0;
                margin-top: 3px;
            }

    @@media (max-width: 1100px) {
        .split-layout {
            grid-template-columns: 1fr;
        }

        .preview-column {
            position: relative;
            top: 0;
        }
    }
</style>

<div class="testimonial-create-container">
    <div class="page-header">
        <div class="header-ornament">
            <div class="ornament-line"></div>
            <div class="ornament-diamond"></div>
            <div class="ornament-line"></div>
        </div>
        <h1 class="page-title">
            Update <span class="title-accent">Client</span> Testimonial
        </h1>
        <p class="page-subtitle">
            Modify the existing testimonial details to ensure client experiences are accurately represented.
        </p>
    </div>

    <form method="post" id="testimonialForm">
        <input type="hidden" asp-for="TestimonialId" />
        <div class="split-layout">
            <div class="form-column">
                <div class="form-section">
                    <h2 class="section-title">Personal Information</h2>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" asp-for="NameSurname">
                                Name Surname <span class="label-required">*</span>
                            </label>
                            <input type="text"
                                   class="form-input"
                                   asp-for="NameSurname"
                                   id="nameInput"
                                   placeholder="E.g.: John Doe"
                                   maxlength="100"
                                   required />
                        </div>

                        <div class="form-group">
                            <label class="form-label" asp-for="Title">
                                Title <span class="label-required">*</span>
                            </label>
                            <input type="text"
                                   class="form-input"
                                   asp-for="Title"
                                   id="titleInput"
                                   placeholder="E.g.: CEO, Manager"
                                   maxlength="100"
                                   required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="ImageUrl">
                            Photo URL <span class="label-required">*</span>
                        </label>
                        <input type="url"
                               class="form-input"
                               asp-for="ImageUrl"
                               id="imageUrlInput"
                               placeholder="https://example.com/photo.jpg"
                               required />
                        <div class="input-meta">
                            <div class="input-hint">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                Professional photo recommended
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h2 class="section-title">Evaluation</h2>

                    <div class="form-group">
                        <label class="form-label" asp-for="ReviewDetail">
                            Review Detail <span class="label-required">*</span>
                        </label>
                        <textarea class="form-textarea"
                                  asp-for="ReviewDetail"
                                  id="reviewInput"
                                  placeholder="Describe your client's experience and thoughts here..."
                                  maxlength="500"
                                  required></textarea>
                        <div class="input-meta">
                            <div class="input-hint">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                                </svg>
                                Use a sincere and authentic tone
                            </div>
                            <span class="char-counter">
                                <span id="reviewCounter">0</span>/500
                            </span>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="rating-wrapper">
                            <div class="rating-label">Rating Score</div>
                            <div class="stars-container" id="starsContainer">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <div class="star active" data-value="@i">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                        </svg>
                                    </div>
                                }
                            </div>
                            <input type="hidden" asp-for="ReviewScore" id="reviewScoreInput" value="5" />
                            <div class="rating-value">
                                Selected Score: <strong id="ratingDisplay">5</strong> / 5
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="status-wrapper">
                            <div class="status-label">
                                <h4>Publishing Status</h4>
                                <p>Publish the testimonial immediately</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" asp-for="Status" id="statusToggle" checked />
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="luxury-info">
                    <h3 class="info-title">Premium Tips</h3>
                    <ul class="info-list">
                        <li>Share real client experiences</li>
                        <li>Use professional and clear photos</li>
                        <li>Reviews should be sincere and heartfelt</li>
                        <li>Including a title adds credibility</li>
                    </ul>
                </div>

                <div class="form-actions">
                    <a href="/Testimonial/TestimonialList" class="btn btn-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                        <span>Cancel</span>
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>Update</span>
                    </button>
                </div>
            </div>

            <div class="preview-column">
                <div class="preview-wrapper">
                    <div class="preview-label">Live Preview</div>
                    <div class="testimonial-card">
                        <div class="quote-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z" />
                            </svg>
                        </div>
                        <div class="avatar-preview">
                            <img src="" id="previewAvatar" alt="Preview" />
                            <div class="avatar-placeholder" id="avatarPlaceholder">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </div>
                        </div>
                        <h3 class="preview-name" id="previewName">Name Surname</h3>
                        <p class="preview-title" id="previewTitle">Title</p>
                        <div class="preview-stars" id="previewStars">
                            @for (int i = 0; i < 5; i++)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
                            }
                        </div>
                        <p class="preview-review" id="previewReview">"Review text will appear here..."</p>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    const nameInput = document.getElementById('nameInput');
    const titleInput = document.getElementById('titleInput');
    const imageUrlInput = document.getElementById('imageUrlInput');
    const reviewInput = document.getElementById('reviewInput');
    const reviewCounter = document.getElementById('reviewCounter');

    const previewName = document.getElementById('previewName');
    const previewTitle = document.getElementById('previewTitle');
    const previewReview = document.getElementById('previewReview');
    const previewAvatar = document.getElementById('previewAvatar');
    const avatarPlaceholder = document.getElementById('avatarPlaceholder');
    const previewStars = document.getElementById('previewStars');

    const stars = document.querySelectorAll('.star');
    const reviewScoreInput = document.getElementById('reviewScoreInput');
    const ratingDisplay = document.getElementById('ratingDisplay');

    nameInput.addEventListener('input', (e) => {
        previewName.textContent = e.target.value || 'Name Surname';
    });

    titleInput.addEventListener('input', (e) => {
        previewTitle.textContent = e.target.value || 'Title';
    });

    reviewInput.addEventListener('input', (e) => {
        reviewCounter.textContent = e.target.value.length;
        previewReview.textContent = e.target.value ? `"${e.target.value}"` : '"Review text will appear here..."';
    });

    imageUrlInput.addEventListener('input', (e) => {
        const url = e.target.value.trim();
        if (url) {
            previewAvatar.src = url;
            previewAvatar.onload = () => {
                previewAvatar.classList.add('show');
                avatarPlaceholder.style.display = 'none';
            };
            previewAvatar.onerror = () => {
                previewAvatar.classList.remove('show');
                avatarPlaceholder.style.display = 'flex';
            };
        } else {
            previewAvatar.classList.remove('show');
            avatarPlaceholder.style.display = 'flex';
        }
    });

    stars.forEach(star => {
        star.addEventListener('click', () => {
            const val = parseInt(star.getAttribute('data-value'));
            reviewScoreInput.value = val;
            ratingDisplay.textContent = val;

            stars.forEach((s, index) => {
                s.classList.toggle('active', index < val);
            });

            const starSvgs = previewStars.querySelectorAll('svg');
            starSvgs.forEach((svg, index) => {
                svg.style.opacity = index < val ? '1' : '0.3';
            });
        });
    });

    const form = document.getElementById('testimonialForm');
    form.addEventListener('submit', (e) => {
        if (!nameInput.value.trim() || !titleInput.value.trim() || !imageUrlInput.value.trim() || !reviewInput.value.trim()) {
            e.preventDefault();
            alert('Please fill in all required fields!');
        }
    });
</script>



